# Copy to .env and fill in. Never commit .env — it holds secrets.

# ── Production API ────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=https://api.fetchmart.com.ng
EXPO_PUBLIC_SOCKET_URL=https://api.fetchmart.com.ng

# ── Mapbox ────────────────────────────────────────────────────────────────────
# Public token (pk.…) — safe to ship in the app bundle; used for map rendering
# and the Directions API.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.REPLACE_ME
# Secret download token (sk.…) — build-time only, used to fetch the native SDK.
# Must NOT appear in app.json or any committed file.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.REPLACE_ME

# ── Google Places API (address autocomplete) ──────────────────────────────────
# https://console.cloud.google.com/apis/credentials → restrict to "Places API"
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=REPLACE_ME

# ── Google Sign-In (optional — the button hides itself while unset) ──────────
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
