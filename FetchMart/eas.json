{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.fetchmart.com.ng",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.fetchmart.com.ng"
      }
    },
    "production": {
      "ios": {
        "resourceClass": "m1-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.fetchmart.com.ng",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.fetchmart.com.ng"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "tarri9192@gmail.com",
        "ascAppId": "6798378487",
        "appleTeamId": "36AUUZMDJ9"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
