# Append this block to the Caddyfile your existing Caddy container already
# serves (the one under /opt/hirracv/deploy/). Do not start a second Caddy —
# only one process can hold ports 80 and 443.
#
# Caddy obtains and renews the certificate automatically; there is no certbot
# step. `fetchmart-api` is the container name, resolved over the shared `web`
# Docker network.

api.fetchmart.com.ng {
	reverse_proxy fetchmart-api:3000

	# The mobile app tracks riders over a websocket; Caddy proxies the upgrade
	# transparently, so no extra config is required for /socket.io.

	encode gzip

	log {
		output file /var/log/caddy/fetchmart-access.log
		roll_size 10MB
		roll_keep 5
	}
}
