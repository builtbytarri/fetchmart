# Application
APP_PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/market_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Korah Pay
KORAH_PUBLIC_KEY=your-korah-public-key
KORAH_SECRET_KEY=your-korah-secret-key
KORAH_WEBHOOK_SECRET=your-korah-webhook-secret

# Map Provider
MAP_PROVIDER=google
MAP_API_KEY=your-map-api-key

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET_NAME=your-r2-bucket-name
