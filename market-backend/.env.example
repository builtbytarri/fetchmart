# Copy to .env and fill in. Never commit .env.
# Every REPLACE_ME below must be set before going to production.

APP_PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
# Required. BullMQ drives the store-accept timeout and rider-offer expiry —
# without Redis those jobs never fire and paid orders sit unrefunded forever.
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
# Anyone holding these can mint a token for any account. Never reuse the dev
# values, and rotate if they are ever exposed.
JWT_ACCESS_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME

# ── Flutterwave ───────────────────────────────────────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=REPLACE_ME
FLUTTERWAVE_SECRET_KEY=REPLACE_ME
FLUTTERWAVE_ENCRYPTION_KEY=REPLACE_ME
# Shared secret for webhook authentication. Generate with:
#   openssl rand -hex 32
# The identical value must be pasted into the Flutterwave dashboard under
# Settings → Webhooks, or every incoming webhook is rejected.
FLUTTERWAVE_WEBHOOK_HASH=REPLACE_ME

# NOTE: the server's public IP must be whitelisted in the Flutterwave dashboard
# before the Transfers API works. Until then payouts, withdrawals and pool
# funding all fail with "Please enable IP Whitelisting to access this service".

# ── Cloudinary (image uploads) ────────────────────────────────────────────────
# https://console.cloudinary.com → Dashboard shows all three.
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# ── Apple Sign In ─────────────────────────────────────────────────────────────
# Must match the iOS bundle identifier exactly, or Apple sign-in returns 401.
APPLE_BUNDLE_ID=com.fetchmart.app

# ── Maps ──────────────────────────────────────────────────────────────────────
MAP_PROVIDER=google
MAP_API_KEY=REPLACE_ME

# ── SMS / OTP (Termii) ────────────────────────────────────────────────────────
# 'mock' logs the code to the console (local dev); 'termii' sends real SMS.
SMS_PROVIDER=mock
# Termii dashboard → Settings → API Key
TERMII_API_KEY=REPLACE_WITH_TERMII_API_KEY
# Exactly as shown in the Termii dashboard's SENDER ID column.
TERMII_SENDER_ID=OE Alert
# 'dnd' is required to reach Nigerian numbers with Do-Not-Disturb enabled.
# On the cheaper 'generic' route those messages are dropped silently.
TERMII_CHANNEL=dnd

# Numbers that bypass SMS with a fixed code — "number:code" pairs, comma-separated.
# Our Termii sender ID covers Nigeria only, so App Review testers on foreign
# numbers cannot receive a real code. Give Apple this number + code in the
# App Review Information section. Remove or rotate after launch.
OTP_TEST_NUMBERS=15550100:4719
